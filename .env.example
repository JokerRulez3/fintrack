# Frontend (Vite) — same Supabase project as InvestIQ is fine
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key

# Server only (Vercel → Settings → Environment Variables). Never prefix these with VITE_.
ANTHROPIC_API_KEY=sk-ant-...
ALLOWED_EMAILS=you@example.com
# optional
CLAUDE_MODEL=claude-sonnet-5-5

# Local testing only: run against demo/demo-data.json with no Supabase
# VITE_DEMO=1
